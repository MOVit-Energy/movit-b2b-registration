SHOPIFY_SHOP=movitenergy.myshopify.com
SHOPIFY_API_KEY=...
SHOPIFY_API_SECRET=...
# Scopes navíc potřebné pro poobjednávkový e-mail (cron/*): read_orders, write_orders,
# read_products, write_products (kromě již existujících read_markets/write_markets).

# Klaviyo Private API key (pk_...) pro odesílání transakčních events.
KLAVIYO_PRIVATE_KEY=pk_...
# Verze Klaviyo API (revision header). Nech default, pokud nevíš.
KLAVIYO_API_REVISION=2025-04-15

# Slack Incoming Webhook pro admin notifikace o nových B2B žádostech.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# E-mail admina, kam chodí notifikace o nové B2B žádosti (přes Klaviyo).
EMAIL_ADMIN=tomas.zaruba@movitenergy.cz

APPROVAL_TOKEN_SECRET=...

# ID B2B marketu (Settings → Markets). Lokace nove firmy se do nej pri registraci
# prida, cimz firma dostane B2B katalog navazany na tento market.
# Vyzaduje scopes read_markets + write_markets.
B2B_MARKET_ID=gid://shopify/Market/...

# ID existujiciho B2B katalogu (Products → Catalogs v Shopify adminu). Katalog je
# typu MarketCatalog a patri do B2B_MARKET_ID — prirazuje se skrz market, ne primo.
B2B_CATALOG_ID=gid://shopify/Catalog/...
SHOP_URL=https://movitenergy.cz

# Veřejná URL této aplikace (schvalovací odkazy /api/b2b/approve|reject).
APP_URL=https://movit-b2b-registration.vercel.app

# Povolené originy pro CORS (čárkou oddělené). Když chybí, použije se SHOP_URL.
ALLOWED_ORIGINS=https://movitenergy.cz

# ── Poobjednávkový e-mail (cron/sync-bestsellers, cron/send-order-followups) ──

# Sdílený secret pro Vercel Cron (Vercel posílá `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=...

# Token pro manuální spuštění /api/sync-bestsellers a /api/send-order-followups při testování.
SYNC_TOKEN=...

# Kolik dní zpětně se počítá prodejnost produktů pro řazení v e-mailu (výchozí 90).
BESTSELLER_LOOKBACK_DAYS=90

# Jak daleko do minulosti hledat kandidátní (fulfilled) objednávky (výchozí 30 dní).
# Musí být >= FOLLOWUP_DELAY_HOURS, jinak by mohly objednávky vypadnout z okna dřív, než na ně dojde řada.
ORDER_LOOKBACK_DAYS=30

# Kolik hodin po "Delivered" se má e-mail odeslat (výchozí 24).
FOLLOWUP_DELAY_HOURS=24

# Čas odeslání se nastavuje přímo ve vercel.json (cron schedule, 1x denně,
# "0 6 * * *" = 7:00 CET / 8:00 CEST) — Hobby plán nepodporuje hodinový cron.
